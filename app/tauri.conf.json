{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Euro-Hub",
  "version": "2.7.0",
  "identifier": "app.westplay",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:release",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Euro-Hub",
        "width": 900,
        "height": 600,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Euro-Hub",
    "copyright": "Copyright © 2026 Euro-Hub (based on WestPlay). Licensed under the GPL-3.0-or-later.",
    "category": "Game",
    "shortDescription": "CarPlay for the screens of your trucks in Euro Truck Simulator 2",
    "longDescription": "Euro-Hub puts a CarPlay-style screen in your truck in Euro Truck Simulator 2: a map made from your own game, music from Apple Music, Spotify and YouTube Music, YouTube, and your game's route, on the truck's own screen.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/dist/": "ui/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyMkMxN0E4QjhCQzkyNTEKUldSUmtyeTRxQmNzUW9ZN29DTmxjQUYyNWhlRnB1VkpZVVpaTXIxZ00yZGtuMzRtdlhMeG4yS0MK",
      "endpoints": ["https://github.com/Luc-nbr/WestPlay/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
